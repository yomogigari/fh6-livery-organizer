# Normalize text files to LF
* text=auto eol=lf

# Windows command scripts use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.xlsx binary
*.zip binary
*.exe binary

# Generated demo HTML: preserve generated line endings
/fh6-livery-organizer-demo.html -text
