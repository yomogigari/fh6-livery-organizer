{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/lo4fh6/organizer-preview-request.schema.json",
  "title": "Livery Organizer for FH6 preview bridge request",
  "description": "Schema for the research prototype bridge that launches the game-facing 3D preview from Livery Organizer for FH6.",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "quality": {
      "type": "string",
      "enum": [
        "auto",
        "1",
        "2",
        "3",
        "4"
      ]
    },
    "v1": {
      "type": "object",
      "required": [
        "source",
        "game_folder",
        "car_id"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lo4fh6_organizer_preview_request_v1"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "game_folder": {
          "type": "string",
          "minLength": 1
        },
        "car_id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "output_key": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/quality"
        },
        "record_id": {
          "type": "string"
        },
        "slot_label": {
          "type": "string"
        },
        "list_name": {
          "type": "string"
        },
        "creator_name": {
          "type": "string"
        },
        "vehicle_name": {
          "type": "string"
        },
        "share_code": {
          "type": "string"
        },
        "upload_date": {
          "type": "string"
        },
        "gamedb_car_body_id": {
          "type": "integer",
          "minimum": 1
        },
        "wheel_placement": {
          "type": "string",
          "enum": [
            "gamedb",
            "carbin"
          ]
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "wheel_source": {
          "type": "string",
          "enum": [
            "proxy",
            "stock",
            "game-fit",
            "source-verified"
          ]
        }
      },
      "additionalProperties": true
    },
    "v2": {
      "type": "object",
      "required": [
        "format",
        "source",
        "environment",
        "vehicle"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lo4fh6_organizer_preview_request_v2"
          ]
        },
        "source": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "environment": {
          "type": "object",
          "required": [
            "game_folder"
          ],
          "properties": {
            "game_folder": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "vehicle": {
          "type": "object",
          "required": [
            "car_id"
          ],
          "properties": {
            "car_id": {
              "type": "integer",
              "minimum": 1
            },
            "vehicle_name": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "viewer": {
          "type": "object",
          "properties": {
            "quality": {
              "$ref": "#/$defs/quality"
            },
            "gamedb_car_body_id": {
              "type": "integer",
              "minimum": 1
            },
            "wheel_placement": {
              "type": "string",
              "enum": [
                "gamedb",
                "carbin"
              ]
            },
            "wheel_source": {
              "type": "string",
              "enum": [
                "proxy",
                "stock",
                "game-fit",
                "source-verified"
              ]
            }
          },
          "additionalProperties": true
        },
        "display": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "creator_name": {
              "type": "string"
            },
            "vehicle_name": {
              "type": "string"
            },
            "share_code": {
              "type": "string"
            },
            "upload_date": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "organizer": {
          "type": "object",
          "properties": {
            "record_id": {
              "type": "string"
            },
            "slot_label": {
              "type": "string"
            },
            "list_name": {
              "type": "string"
            },
            "output_key": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
