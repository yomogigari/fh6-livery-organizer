# FH6 Livery Organizer
# Project-specific ignore rules only.
# Keep this file intentionally small so new repository files are visible to Git.

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE / editor local state
.idea/
.vscode/
*.code-workspace

# OS-generated files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Local logs / temporary files
*.log
*.tmp
*.bak
*~
~$*

# Python build / package outputs
build/
dist/
*.egg-info/

# Internal build resources (not for public distribution)
/internal/

# Build work directories if tools are run from the repository root
/.build-venv/
/.build-tk/
/build-work/
/build-reports/
/release/

# Temporary Git audit files
/git-status.txt
/git-tracked-files.txt
/git-untracked-files.txt
/git-ignored-files.txt
